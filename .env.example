# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=winline_review
DB_USER=postgres
DB_PASSWORD=your_password_here

# Winline Auth (для обхода капчи)
WINLINE_LOGIN=your_phone_or_email
WINLINE_PASSWORD=your_password

# Server
PORT=3001
NODE_ENV=development

# Scraper settings
SCRAPE_INTERVAL_HOURS=1
SCRAPE_MAX_EVENTS_PER_SPORT=50
SCRAPE_HEADLESS=true

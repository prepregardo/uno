# Vercel Postgres (скопируйте из Vercel Dashboard → Storage → .env.local)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Winline Auth (опционально, для обхода капчи)
WINLINE_LOGIN=
WINLINE_PASSWORD=

# Scraper settings
SCRAPE_HEADLESS=true
SCRAPE_MAX_EVENTS_PER_SPORT=30
